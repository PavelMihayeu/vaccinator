<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001" author="vaccinator">
        
        <!-- 1. Vaccine master table -->
        <createTable tableName="vaccine">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="type" type="varchar(50)"/>
            <column name="description" type="text"/>
            <column name="who_reference_url" type="text"/>
            <column name="created_by" type="varchar(100)"/>
            <column name="updated_by" type="varchar(100)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 2. Age groups table -->
        <createTable tableName="age_group">
            <column name="id" type="serial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(50)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>

        <!-- 3. Regions table -->
        <createTable tableName="region">
            <column name="id" type="serial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>

        <!-- 4. Considerations table -->
        <createTable tableName="consideration">
            <column name="id" type="serial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="text"/>
        </createTable>

        <!-- 5. Vaccine <-> Age Group (many-to-many) -->
        <createTable tableName="vaccine_target_group">
            <column name="vaccine_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="age_group_id" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="vaccine_target_group" columnNames="vaccine_id, age_group_id"/>
        <addForeignKeyConstraint baseTableName="vaccine_target_group" baseColumnNames="vaccine_id"
                                 referencedTableName="vaccine" referencedColumnNames="id"
                                 constraintName="fk_vaccine_target_group_vaccine"/>
        <addForeignKeyConstraint baseTableName="vaccine_target_group" baseColumnNames="age_group_id"
                                 referencedTableName="age_group" referencedColumnNames="id"
                                 constraintName="fk_vaccine_target_group_age_group"/>

        <!-- 6. Vaccine <-> Region (many-to-many) -->
        <createTable tableName="vaccine_region">
            <column name="vaccine_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="region_id" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="vaccine_region" columnNames="vaccine_id, region_id"/>
        <addForeignKeyConstraint baseTableName="vaccine_region" baseColumnNames="vaccine_id"
                                 referencedTableName="vaccine" referencedColumnNames="id"
                                 constraintName="fk_vaccine_region_vaccine"/>
        <addForeignKeyConstraint baseTableName="vaccine_region" baseColumnNames="region_id"
                                 referencedTableName="region" referencedColumnNames="id"
                                 constraintName="fk_vaccine_region_region"/>

        <!-- 7. Vaccine <-> Consideration (many-to-many) -->
        <createTable tableName="vaccine_consideration">
            <column name="vaccine_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="consideration_id" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="vaccine_consideration" columnNames="vaccine_id, consideration_id"/>
        <addForeignKeyConstraint baseTableName="vaccine_consideration" baseColumnNames="vaccine_id"
                                 referencedTableName="vaccine" referencedColumnNames="id"
                                 constraintName="fk_vaccine_consideration_vaccine"/>
        <addForeignKeyConstraint baseTableName="vaccine_consideration" baseColumnNames="consideration_id"
                                 referencedTableName="consideration" referencedColumnNames="id"
                                 constraintName="fk_vaccine_consideration_consideration"/>

        <!-- 8. Vaccine Schedule table -->
        <createTable tableName="vaccine_schedule">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="vaccine_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="schedule_type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="created_by" type="varchar(100)"/>
            <column name="updated_by" type="varchar(100)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="vaccine_schedule" baseColumnNames="vaccine_id"
                                 referencedTableName="vaccine" referencedColumnNames="id"
                                 constraintName="fk_vaccine_schedule_vaccine"/>

        <!-- 9. Doses table -->
        <createTable tableName="dose">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="schedule_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="dose_number" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="min_age" type="varchar(50)"/>
            <column name="is_booster" type="boolean" defaultValueBoolean="false"/>
            <column name="note" type="text"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="dose" baseColumnNames="schedule_id"
                                 referencedTableName="vaccine_schedule" referencedColumnNames="id"
                                 constraintName="fk_dose_vaccine_schedule"/>

        <!-- Insert initial data -->
        <insert tableName="age_group">
            <column name="name" value="Infant"/>
        </insert>
        <insert tableName="age_group">
            <column name="name" value="Child"/>
        </insert>
        <insert tableName="age_group">
            <column name="name" value="Adolescent"/>
        </insert>
        <insert tableName="age_group">
            <column name="name" value="Adult"/>
        </insert>
        <insert tableName="age_group">
            <column name="name" value="Elderly"/>
        </insert>

        <insert tableName="region">
            <column name="name" value="Global"/>
        </insert>
        <insert tableName="region">
            <column name="name" value="Asia"/>
        </insert>
        <insert tableName="region">
            <column name="name" value="Europe"/>
        </insert>
        <insert tableName="region">
            <column name="name" value="North America"/>
        </insert>
        <insert tableName="region">
            <column name="name" value="Sub-Saharan Africa"/>
        </insert>

        <insert tableName="consideration">
            <column name="name" value="Pregnancy"/>
            <column name="description" value="Special considerations for pregnant women"/>
        </insert>
        <insert tableName="consideration">
            <column name="name" value="HIV+"/>
            <column name="description" value="Special considerations for HIV positive individuals"/>
        </insert>
        <insert tableName="consideration">
            <column name="name" value="Co-administration"/>
            <column name="description" value="Can be administered with other vaccines"/>
        </insert>
        <insert tableName="consideration">
            <column name="name" value="Immunocompromised"/>
            <column name="description" value="Special considerations for immunocompromised individuals"/>
        </insert>

    </changeSet>

</databaseChangeLog> 